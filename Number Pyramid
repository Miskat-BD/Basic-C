#include <stdio.h>

int main() {
    int n, i, j;

    // Input the number of rows
    printf("Enter the number of rows: ");
    scanf("%d", &n);

    // Generate the number pyramid pattern
    for (i = 1; i <= n; i++) {
        for (j = 1; j <= i; j++) {
            printf("%d ", j);
        }
        printf("\n");
    }

    return 0;
}
