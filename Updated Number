#include<stdio.h>
int main()
{
int a[100],i,position,n,update;
printf("Number Of Elements: ");
scanf("%d",&n);
for(i=0;i<n;i++)
{
scanf("%d",&a[i]);
}
printf("Position: ");
scanf("%d",&position);
printf("Updated Value: ");
scanf("%d",&update);
a[position-1]=update;
for(i=0;i<n;i++)
{
printf("%d ",a[i]);
}
return 0;
}
