#include <stdio.h>

int main() {
    int n, i, j;

    // Input the number of rows
    printf("Enter the number of rows: ");
    scanf("%d", &n);

    // Generate the reverse pyramid pattern
    for (i = n; i >= 1; i--) {
        for (j = 1; j <= i; j++) {
            printf("* ");
        }
        printf("\n");
    }

    return 0;
}
