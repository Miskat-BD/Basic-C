#include <stdio.h>

int main() {
    char ch;

    // Input a character
    printf("Enter a character: ");
    scanf("%c", &ch);

    // Check if it is a capital letter, small letter, or neither
    if (ch >= 'A' && ch <= 'Z') {
        printf("'%c' is a capital letter.\n", ch);
    } else if (ch >= 'a' && ch <= 'z') {
        printf("'%c' is a small letter.\n", ch);
    } else {
        printf("'%c' is neither a capital nor a small letter.\n", ch);
    }

    return 0;
}
